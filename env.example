# Пример переменных окружения для проекта TIR-Lugansk
# Скопируйте в .env в корне проекта или в tir_lugansk/ и заполните значения.

# Django
DJANGO_SECRET_KEY=your-secret-key-here
# Макс. размер сохранения в админке (HTML в CKEditor), мегабайт. Нужен также nginx: client_max_body_size
# DATA_UPLOAD_MAX_MB=50

# PostgreSQL (при использовании settings_prod и переходе с SQLite)
# Если DB_NAME задан, в проде используется PostgreSQL; иначе — SQLite.
DB_NAME=tir_lugansk
DB_USER=tir_db
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Опционально: папка для загружаемых изображений (импорт)
# INCOMING_IMAGES_DIR=/var/www/tir-lugansk/incoming_images

# Watermark для импортируемых изображений товаров
# 0/1 — выключено/включено
# WATERMARK_ENABLED=1
# WATERMARK_IMAGE_PATH=staticfiles/img/logo_footer.png
# WATERMARK_SCALE=0.22
# WATERMARK_OPACITY=0.18
# WATERMARK_MARGIN=16
# WATERMARK_POSITION=center  # center | bottom_right | top_left | top_right | bottom_left
# WATERMARK_FIT_MODE=full    # full | scale
# Команда для уже существующих файлов:
# python manage.py apply_watermark_to_images

# Email-уведомления о заявках (звонок / запрос цены)
# Для теста можно отправлять на один адрес:
# NOTIFICATION_EMAIL_RECIPIENTS=astbackend@yandex.ru
# Для нескольких адресов — через запятую:
# NOTIFICATION_EMAIL_RECIPIENTS=manager1@example.com,manager2@example.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=

# Telegram-уведомления о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX-уведомления о заявках
MAX_BOT_TOKEN=
MAX_OWNER_ID=
# Базовый URL API (если отличается от дефолтного)
# MAX_API_BASE_URL=https://api.max.ru

# Celery / Redis (асинхронная отправка уведомлений)
# По умолчанию берётся REDIS_URL (если CELERY_BROKER_URL не указан)
# CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
# Для локальной отладки без worker можно включить eager-режим:
# CELERY_TASK_ALWAYS_EAGER=1
